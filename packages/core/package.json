{
  "name": "@convetlib/core",
  "version": "0.1.0-beta.0",
  "description": "Framework-agnostic document engine: model, schema, contracts.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
